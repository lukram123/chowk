# Copy to .env.local and fill in. Values come from the Firebase console:
# Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Region the Cloud Functions are deployed to.
VITE_FUNCTIONS_REGION=asia-south1

# Set to "demo" to run with built-in sample data and no Firebase project.
# `npm run dev` uses demo data automatically while the Firebase values are empty.
VITE_BACKEND=

# Optional links. Each button or line is hidden while its value is empty.
VITE_APP_URL=
VITE_WHATSAPP_CHANNEL_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
