# Used by `npm run dev:emulator`: the site talks to the Firebase emulators on this computer.
# "demo-chowk" is a stand-in project, so nothing here touches a real Firebase project and these
# values are not secrets. Start the emulators first (see README, "Test end to end on your computer").
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-chowk.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-chowk
VITE_FIREBASE_APP_ID=demo-app
VITE_FUNCTIONS_REGION=asia-south1
VITE_DEFAULT_PINCODE=560102
